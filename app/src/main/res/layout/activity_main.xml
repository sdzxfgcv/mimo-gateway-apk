<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MiMo Gateway · Eta 工具版"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MiMo App 通道（OpenAI 兼容）· 原生支持 tools / tool_calls / 思考"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="第一步：点下面按钮，在 App 内用小米账号登录一次，抓取 passToken。"
            android:textSize="13sp"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 App 内登录获取 passToken（推荐）"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="或手动粘贴 Cookie / cURL（需含 passToken）："
            android:textSize="13sp"
            android:layout_marginTop="14dp" />

        <EditText
            android:id="@+id/etCurl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="粘贴含 passToken 的 Cookie 或 cURL"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:maxLines="6"
            android:gravity="top"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="解析并导入凭据"
            android:layout_marginTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前凭证（可手动修改）："
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etServiceToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="passToken（核心凭证）"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etUserId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="userId"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etPhToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="cUserId（可留空）"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="客户端调用密钥 (apiKey，可自定义)"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="端口 (默认 8080)"
            android:inputType="number"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="保存配置" />
            <Button
                android:id="@+id/btnToggle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="启动服务" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态：未启动"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</ScrollView>
